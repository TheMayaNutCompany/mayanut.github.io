                  'يتركز عمل الزراعة والمنتجات حالياً في جنوب فلوريدا ومناطق خالية من الصقيع. الهدف ' +
                  'هو الوصول إلى أول إطلاق منتجات فعّال في أواخر العقد، بعد أن تنتج مزروعات ' +
                  '<span class="highlight-brosimum"><em>Brosimum alicastrum</em></span> بشكل مستقر.'
                );
              }));
            }

            if(searchBtn){
              const storeInput = document.getElementById('store-search-input');
              searchBtn.addEventListener('click', guard((e)=>{
                e.stopPropagation();
                show(
                  'بحث &amp; استفسار',
                  'يمكنك البحث في قسم المتجر عن منتجات <span class="highlight-mayanut">مايانَت</span> ' +
                  'المستقبلية، أو استخدام مساعد الأسئلة الشائعة في الأسفل لطرح أسئلة عن الشجرة، الوصفات، ' +
                  'الزراعة الحرجية، أو الأبحاث.'
                );
                if(storeInput){
                  setTimeout(()=>{
                    storeInput.scrollIntoView({behavior:'smooth', block:'center'});
                    storeInput.focus();
                  }, 400);
                }
              }));
            }

            // Legal popovers
            $$('[data-legal-link]').forEach(link=>{
              link.addEventListener('click', (e)=>{
                e.preventDefault();
                if(window.mayanutWelcomeOpen){
                  show(
                    'متابعة أولاً',
                    'يرجى إغلاق رسالة الترحيب أولاً ثم يمكنك عرض معلومات الخصوصية أو الشروط.'
                  );
                  return;
                }
                const type = link.getAttribute('data-legal-link');
                if(type === 'privacy'){
                  show(
                    'الخصوصية',
                    'سيتم نشر سياسة خصوصية كاملة عندما يبدأ mayanut.com بجمع بيانات العملاء. ' +
                    'حالياً الموقع معلوماتي وتجريبي ولا يعالج طلبات شراء مباشرة.'
                  );
                }else if(type === 'terms'){
                  show(
                    'شروط الاستخدام',
                    'شروط الاستخدام المستقبلية ستغطي المبيعات، الشحن، والتنبيهات المتعلقة بمنتجات ' +
                    '<span class="highlight-mayanut">مايانَت</span>. في هذه المرحلة، الموقع تجريبي ' +
                    'وغير تجاري بالكامل.'
                  );
                }else if(type === 'sitemap'){
                  show(
                    'خريطة الموقع',
                    'الأقسام في هذه الصفحة: الرئيسية، المتجر، حول، الأبحاث، المعرض، الوصفات، الأسئلة الشائعة، الاتصال. ' +
                    'كلها مكدسة في صفحة واحدة طويلة لسهولة التصفح.'
                  );
                }
              });
            });
          })();

          /* LANGUAGE DROPDOWN: route to index-xx.html */
          (function setupLanguageDropdown(){
            const langSelect = document.getElementById('language-select');
            if(!langSelect) return;

            const mapping = {
              'en': 'index.html',
              'fr': 'index-fr.html',
              'es': 'index-es.html',
              'de': 'index-de.html',
              'ja': 'index-ja.html',
              'ar-eg': 'index-ar-eg.html'
            };

            langSelect.addEventListener('change', ()=>{
              if(window.mayanutWelcomeOpen) return; // blocked until welcome closed
              const val = langSelect.value;
              const target = mapping[val];
              if(target){
                window.location.href = target;
              }
            });
          })();

          /* EASTER EGG: long-press on header logo -> show ricky.jpeg under hero image */
          (function setupLogoEasterEgg(){
            const logo = document.getElementById('site-logo-click');
            if(!logo) return;
            let pressTimer = null;

            const trigger = () => {
              let heroMedia = document.getElementById('hero-media');
              if(!heroMedia){
                heroMedia = document.querySelector('.hero-media') || document.getElementById('hero');
              }
              if(!heroMedia) return;

              let eggImg = document.getElementById('mayanut-ricky-egg');
              if(!eggImg){
                eggImg = document.createElement('img');
                eggImg.id = 'mayanut-ricky-egg';
                eggImg.src = 'ricky.jpeg';
                eggImg.alt = 'سر مايانَت المخفي';
                eggImg.style.display = 'block';
                eggImg.style.margin = '12px auto 0';
                eggImg.style.maxWidth = '260px';
                eggImg.style.borderRadius = '16px';
                eggImg.style.boxShadow = '0 10px 40px rgba(0,0,0,0.85)';
                eggImg.style.border = '2px solid rgba(250,204,21,0.9)';
                heroMedia.appendChild(eggImg);

                const caption = document.createElement('div');
                caption.textContent = 'تم تفعيل توجيه مايانَت السري. وضع النمو الجذري: ON.';
                caption.style.fontSize = '11px';
                caption.style.marginTop = '4px';
                caption.style.opacity = '0.95';
                caption.style.textAlign = 'center';
                caption.style.color = '#facc15';
                heroMedia.appendChild(caption);
              }
            };

            const startPress = () => {
              if(pressTimer) clearTimeout(pressTimer);
              pressTimer = setTimeout(trigger, 1000);
            };
            const cancelPress = () => {
              if(pressTimer) clearTimeout(pressTimer);
              pressTimer = null;
            };

            logo.addEventListener('mousedown', startPress);
            logo.addEventListener('touchstart', startPress);
            ['mouseup','mouseleave','touchend','touchcancel'].forEach(ev=>{
              logo.addEventListener(ev, cancelPress);
            });
          })();

          /* SIMPLE SEO HIDDEN KEYWORDS */
          (function injectHiddenSeo(){
            const main = document.querySelector('main') || document.body;
            if(!main) return;
            const span = document.createElement('span');
            span.style.position = 'absolute';
            span.style.left = '-9999px';
            span.style.width = '1px';
            span.style.height = '1px';
            span.style.overflow = 'hidden';
            span.textContent =
              'MayaNut superfood, Brosimum alicastrum, nuez de ramón, ojoche, breadnut, ' +
              'tropical canopy tree, hurricane-resistant tree crop, South Florida plantations, ' +
              'MayaNut beverages, MayaNut powder, sustainable agroforestry, The MayaNut Company, ' +
              'Moraceae fig family, mulberry relatives.';
            main.appendChild(span);
          })();
        })();
      </script>
    </main>
  </body>
</html>
