          /* HERO SNOW – same as Japanese version */
          (function setupSnow(){
            const hero = document.getElementById('hero');
            if(!hero) return;

            let canvas = document.getElementById('hero-snow-canvas');
            if(!canvas){
              canvas = document.createElement('canvas');
              canvas.id = 'hero-snow-canvas';
              hero.appendChild(canvas);
            }
            const ctx = canvas.getContext('2d');
            let width, height;
            const resize = () => {
              width = canvas.width  = hero.clientWidth;
              height = canvas.height = hero.clientHeight;
            };
            resize();
            window.addEventListener('resize', resize);

            const flakes = [];
            const FLAKE_COUNT = 90;
            for(let i=0;i<FLAKE_COUNT;i++){
              flakes.push({
                x: Math.random()*width,
                y: Math.random()*height,
                r: 2 + Math.random()*2.5,
                speedY: 0.2 + Math.random()*0.4,
                baseDrift: (Math.random()*0.35 - 0.175),
                phase: Math.random()*Math.PI*2,
                angle: Math.random()*Math.PI*2,
                rotationSpeed: (Math.random()*0.4 - 0.2)
              });
            }

            function drawSnowflake(f){
              ctx.save();
              ctx.translate(f.x, f.y);
              ctx.rotate(f.angle);
              const arms = 6;
              for(let i=0;i<arms;i++){
                ctx.rotate(Math.PI*2/arms);
                ctx.beginPath();
                ctx.moveTo(0,0);
                ctx.lineTo(f.r,0);
                ctx.stroke();
                ctx.beginPath();
                ctx.moveTo(f.r*0.5,0);
                ctx.lineTo(f.r*0.7, f.r*0.25);
                ctx.moveTo(f.r*0.5,0);
                ctx.lineTo(f.r*0.7,-f.r*0.25);
                ctx.stroke();
              }
              ctx.restore();
            }

            function tick(){
              ctx.clearRect(0,0,width,height);
              ctx.strokeStyle = 'rgba(226,232,240,0.9)';
              ctx.lineWidth = 1;

              for(const f of flakes){
                f.phase += 0.01;
                f.angle += f.rotationSpeed * 0.02;
                const drift = f.baseDrift + Math.sin(f.phase*1.4)*0.4;
                f.x += drift;
                f.y += f.speedY * (0.8 + f.r/3);

                if(f.y > height + 10){
                  f.y = -10;
                  f.x = Math.random()*width;
                }
                if(f.x < -12) f.x = width + 12;
                if(f.x > width + 12) f.x = -12;

                drawSnowflake(f);
              }
              requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
          })();

