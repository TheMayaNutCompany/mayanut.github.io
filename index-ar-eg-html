          /* STORE SEARCH: sequential match highlight */
          (function setupStoreSearch(){
            const input   = document.getElementById('store-search-input');
            const message = document.getElementById('store-search-message');
            const cards   = $$('.store-product-card');
            if(!input || cards.length === 0) return;

            const normalize = s => (s || '').toLowerCase().trim();

            function sequentialScore(query, text){
              query = normalize(query);
              text  = normalize(text);
              if(!query || !text) return 0;
              let qi = 0;
              for(let ti=0; ti<text.length && qi<query.length; ti++){
                if(text[ti] === query[qi]){
                  qi++;
                }else{
                  if(qi > 1) break;
                }
              }
              return qi;
            }

            function highlight(query){
              const q = normalize(query);
              let bestCard = null;
              let bestScore = 0;
              cards.forEach(card=>{
                card.classList.remove('store-product-card--active');
                card.style.backgroundColor = '';
              });
              if(!q){
                if(message) message.textContent = '';
                return null;
              }

              cards.forEach(card=>{
                const nameAttr = card.getAttribute('data-product-name') || '';
                const text = nameAttr || card.textContent;
                const score = sequentialScore(q, text);
                if(score >= 2){
                  card.style.backgroundColor = 'rgba(254,240,138,0.8)';
                  if(score > bestScore){
                    bestScore = score;
                    bestCard = card;
                  }
                }
              });
              if(message){
                if(bestScore === 0){
                  message.textContent = 'لا توجد نتائج قوية بعد – تابع الكتابة أو اضغط Enter للتمرير إلى الأقرب.';
                }else{
                  message.textContent = 'تم تمييز أقرب البطاقات أدناه.';
                }
              }
              return bestCard;
            }

            input.addEventListener('input', ()=>{
              highlight(input.value);
            });

            input.addEventListener('keydown', (e)=>{
              if(e.key === 'Enter'){
                e.preventDefault();
                const bestCard = highlight(input.value);
                if(bestCard){
                  bestCard.scrollIntoView({behavior:'smooth', block:'center'});
                }
              }
            });
          })();

